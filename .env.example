# Frontend is deployed to Vercel, which proxies /api/* to the Render API (see
# vercel.json) — so in production VITE_API_URL is unset and the default (/api) is
# correct. Only set this for local dev if running the backend on a different origin.
# VITE_API_URL=http://localhost:4000/api

# Backend vars. Needed by the Prisma CLI and the backend dev server. This is the ONLY
# .env in the repo — server/src/config/env.js resolves it from its own module path, so
# it is found whether the API is started from the repo root or from server/. On Render
# these are set directly as service env vars, not via this file. See docs/SECURITY.md.
DATABASE_URL=postgresql://user:password@host:5432/db
# Must be at least 32 characters — the API refuses to boot otherwise.
JWT_SECRET=change-me-to-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# Only needed by the standalone backend dev server (server/: npm run dev, port 4000)
# talking to a separately-run frontend dev server (vite dev --port 3000).
PORT=4000
CORS_ORIGIN=http://localhost:3000,https://your-frontend-domain.example

# production toggles secure cookies + the prod mailer path; unset is fine for local dev.
NODE_ENV=development

# Base URL used to build password-reset/email-change links, and the Origin allowed on
# state-changing requests. Falls back to the first CORS_ORIGIN entry, then
# http://localhost:3000, in development. REQUIRED when NODE_ENV=production.
APP_URL=http://localhost:3000

# Resend API key. In development, an unset key means reset/email-change links are logged
# to the console instead of emailed. In production the API REFUSES TO BOOT without it:
# an unset key there meant live account-takeover tokens in the log stream and no user
# ever able to complete a reset. See docs/SECURITY.md.
RESEND_API_KEY=
MAIL_FROM=StayFlow <onboarding@resend.dev>

# Log verbosity: debug | info | warn | error | silent.
# Defaults to info in production, debug locally. The test suite sets silent.
# LOG_LEVEL=info

# Number of proxies in front of the API, used to resolve the real client IP for rate
# limiting. Defaults to 2 in production (Vercel edge -> Render router) and 1 locally.
# Set this if the deployment topology changes.
# TRUST_PROXY_HOPS=2
