# Frontend is deployed to Vercel, which proxies /api/* to the Render API (see
# vercel.json) — so in production VITE_API_URL is unset and the default (/api) is
# correct. Only set this for local dev if running the backend on a different origin.
# VITE_API_URL=http://localhost:4000/api

# Backend vars. Needed by the Prisma CLI and the backend dev server. This is the ONLY
# .env in the repo — server/src/config/env.js resolves it from its own module path, so
# it is found whether the API is started from the repo root or from server/. On Render
# these are set directly as service env vars, not via this file. See docs/SECURITY.md.
# Use Neon's POOLED host — the one with `-pooler` in it — for the app itself.
# Neon's free plan allows very few direct connections, and Prisma opens a pool
# per process; the direct host runs out under normal traffic. connection_limit
# keeps this process inside that budget rather than letting Prisma size the pool
# from the CPU count.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require&connection_limit=5&pool_timeout=10
# Direct (non-pooled) host — no `-pooler`. Required alongside DATABASE_URL:
# `prisma migrate deploy` needs a single real session for advisory locks and DDL,
# which PgBouncer's transaction pooling above cannot provide.
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require
# Must be at least 32 characters — the API refuses to boot otherwise.
JWT_SECRET=change-me-to-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# Only needed by the standalone backend dev server (server/: npm run dev, port 4000)
# talking to a separately-run frontend dev server (vite dev --port 3000).
PORT=4000
CORS_ORIGIN=http://localhost:3000,https://your-frontend-domain.example

# production toggles secure cookies + the prod mailer path; unset is fine for local dev.
NODE_ENV=development

# Base URL used to build password-reset/email-change links, and the Origin allowed on
# state-changing requests. Falls back to the first CORS_ORIGIN entry in development;
# there is no localhost default, so an unset value produces a visibly broken link
# rather than one that silently points at the wrong host. REQUIRED in production.
APP_URL=http://localhost:3000

# Resend API key. In development, an unset key means reset/email-change links are logged
# to the console instead of emailed. In production the API REFUSES TO BOOT without it:
# an unset key there meant live account-takeover tokens in the log stream and no user
# ever able to complete a reset. See docs/SECURITY.md.
RESEND_API_KEY=
MAIL_FROM=StayFlow <onboarding@resend.dev>

# Log verbosity: debug | info | warn | error | silent.
# Defaults to info in production, debug locally. The test suite sets silent.
# LOG_LEVEL=info

# Number of proxies in front of the API, used to resolve the real client IP for rate
# limiting. Defaults to 2 in production (Vercel edge -> Render router) and 1 locally.
# Set this if the deployment topology changes.
# TRUST_PROXY_HOPS=2

# Cloudinary. The browser uploads photos straight to Cloudinary using a signature
# this API produces, so the secret never leaves the server and no image bytes pass
# through the API or Postgres. Unset => POST /api/uploads/signature returns 503 and
# the admin UI asks for a photo URL instead of offering a file picker.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=stayflow

# Error tracking. Both are optional: unset means Sentry never initialises and
# nothing is sent. SENTRY_DSN is the API's; VITE_SENTRY_DSN is the browser's and
# is baked into the client bundle at build time, so use a separate DSN for it.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Row retention, in days. auth_events and notifications grow with traffic rather
# than with the size of the property, so they are what fills a fixed storage quota.
# The API sweeps them hourly. 0 disables the sweep for that table.
# AUTH_EVENT_RETENTION_DAYS=90
# NOTIFICATION_RETENTION_DAYS=180
